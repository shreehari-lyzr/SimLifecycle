# Copy to .env and fill in to enable the live Claude AI storage manager.
# Without a key, the advisor falls back to the deterministic heuristic.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (all prefixed SIMLC_):
# SIMLC_AI_MODEL=claude-opus-4-8
# SIMLC_USE_AI=true
# SIMLC_TIME_UNIT_SECONDS=1.0
# SIMLC_SCAN_INTERVAL_SECONDS=5
# SIMLC_RESET_ON_STARTUP=true
